@model IEnumerable<Hotel.Web.ViewModels.ReservaListaViewModel>
<h1>Reservas</h1><p><a asp-action="Create" class="btn btn-primary">Nueva reserva</a></p><table class="table table-striped"><thead><tr><th>Huésped</th><th>Habitación</th><th>Ingreso</th><th>Salida</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var r in Model) { <tr><td>@r.Huesped</td><td>@r.Habitacion</td><td>@r.FechaIngreso</td><td>@r.FechaSalida</td><td>@r.Estado</td><td>@r.Total.ToString("C")</td><td>@if (r.Estado == "Pendiente" || r.Estado == "Confirmada") { <form asp-action="Cancelar" method="post"><input type="hidden" name="id" value="@r.IdReserva"/><button class="btn btn-sm btn-outline-danger">Cancelar</button></form> }</td></tr> }</tbody></table>
