@model IEnumerable<Hotel.Web.ViewModels.HabitacionDisponibleViewModel>
<h1>Disponibilidad</h1><form method="get" class="row g-3 mb-4"><div class="col-md-4"><label class="form-label">Ingreso</label><input type="date" name="ingreso" value="@ViewBag.Ingreso" class="form-control"/></div><div class="col-md-4"><label class="form-label">Salida</label><input type="date" name="salida" value="@ViewBag.Salida" class="form-control"/><span class="text-danger">@Html.ValidationMessage("salida")</span></div><div class="col-md-4 align-self-end"><button class="btn btn-primary">Buscar</button></div></form>
@if (ViewBag.Ingreso != null && !ViewData.ModelState.ContainsKey("salida")) { <table class="table table-striped"><thead><tr><th>Habitación</th><th>Tipo</th><th>Noches</th><th>Total estimado</th></tr></thead><tbody>@foreach (var h in Model) { <tr><td>@h.Numero</td><td>@h.Tipo</td><td>@h.Noches</td><td>@h.TotalEstimado.ToString("C")</td></tr> }</tbody></table> }
